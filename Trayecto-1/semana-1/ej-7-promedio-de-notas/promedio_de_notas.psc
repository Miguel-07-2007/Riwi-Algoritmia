Algoritmo PromedioDeNotas
	Definir nota1, nota2, nota3, suma, promedio Como Real
	Escribir "Ingresa la primera nota (de 0 a 5):"
	Leer nota1
	Escribir "Ingresa la segunda nota (de 0 a 5):"
	Leer nota2
	Escribir "Ingresa la tercera nota (de 0 a 5):"
	Leer nota3
	suma <- nota1 + nota2 + nota3
	promedio <- suma / 3
	Escribir "El promedio es: ", promedio
FinAlgoritmo
